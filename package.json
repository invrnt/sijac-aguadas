{
  "name": "sijac-aguadas",
  "version": "1.0.0",
  "description": "Sistema de Información de Juntas de Acción Comunal de Aguadas",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "test": "bun test",
    "test:ci": "bun test --coverage",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "import:juntas": "bun run scripts/import-juntas.ts",
    "setup:storage": "bun run scripts/setup-storage.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.10",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.25.12",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
