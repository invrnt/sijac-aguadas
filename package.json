{
  "name": "sijac-aguadas",
  "version": "1.0.0",
  "description": "Sistema de Información de Juntas de Acción Comunal de Aguadas",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check": "bun run lint && bun run typecheck && bun run build",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .open-next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sijac --local",
    "db:migrate:remote": "wrangler d1 migrations apply sijac --remote",
    "db:seed": "tsx scripts/seed.ts",
    "import:juntas": "tsx scripts/import-juntas.ts",
    "email:dev": "bunx email dev --dir emails"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "^6.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "wrangler": "^4.151.3"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.25.12",
    "postcss": "8.5.24"
  }
}
