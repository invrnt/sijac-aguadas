# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true

# PostgreSQL de Supabase (use la URL del pooler en producción)
DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Storage (solo se usa en el servidor)
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=sijac-private

# Envío de recuperación e invitaciones (opcional en desarrollo)
RESEND_API_KEY=
EMAIL_FROM=SIJAC Aguadas <no-reply@example.gov.co>

# Observabilidad opcional
SENTRY_DSN=
LOG_LEVEL=info

# Solo para la semilla inicial
SEED_ADMIN_EMAIL=admin@sijac.local
SEED_ADMIN_PASSWORD=
SEED_CONSULTA_EMAIL=consulta@sijac.local
SEED_CONSULTA_PASSWORD=
