{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sijac-aguadas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sijac-aguadas"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sijac",
      // Reemplace con el id que devuelve `wrangler d1 create sijac`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sijac-private"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    // Solo para scripts (`--remote`): apunta los bindings a producción
    // desde la máquina local. No se despliega.
    "remote": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sijac",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "sijac-private",
          "remote": true
        }
      ]
    }
  }
}
