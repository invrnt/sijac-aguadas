{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sijac-aguadas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sijac-aguadas"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sijac",
      "database_id": "91402af9-bd7f-49af-a39a-a517eeefb124",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sijac-private"
    }
  ],
  // Correos con Cloudflare Email Sending (requiere Workers Paid y el dominio
  // del remitente dado de alta en Email Service → Email Sending).
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Sin URLs fijas: la aplicación toma el dominio de cada solicitud, así que
  // funciona igual en *.workers.dev, en un dominio propio y en las copias
  // creadas con el botón «Deploy to Cloudflare».
  "vars": {
    "EMAIL_FROM": "SIJAC Aguadas <no-responder@sijac.org>"
  },
  "observability": {
    "enabled": true
  }
}
