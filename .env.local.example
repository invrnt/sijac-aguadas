# Copie este archivo como .env.local para desarrollo local.
# (No se llama .env.example para que el botón «Deploy to Cloudflare» solo
# pregunte los secretos de .dev.vars.example.)

# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
# Clave del asistente /configuracion-inicial (mínimo 8 caracteres)
SETUP_CODE=

# La base de datos (D1) y los archivos (R2) son bindings de Cloudflare
# declarados en wrangler.jsonc; no requieren variables.

# Envío de recuperación e invitaciones (opcional en desarrollo)
RESEND_API_KEY=
EMAIL_FROM=SIJAC Aguadas <no-reply@example.gov.co>

# Observabilidad opcional
SENTRY_DSN=
LOG_LEVEL=info

# Solo para la semilla inicial
SEED_ADMIN_EMAIL=admin@sijac.local
SEED_ADMIN_PASSWORD=
SEED_CONSULTA_EMAIL=consulta@sijac.local
SEED_CONSULTA_PASSWORD=
